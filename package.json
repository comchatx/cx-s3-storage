{
  "name": "@comchatx/cx-s3-storage",
  "version": "0.1.0",
  "description": "Stores your images in your own bucket, with links for listings.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-s3-storage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-s3-storage.git"
  },
  "bugs": "https://github.com/comchatx/cx-s3-storage/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "skills",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "about": "把商品图片存进你自己的存储桶，生成 listing 用的链接。",
    "mark": {
      "line": "layers"
    },
    "section": "data",
    "order": 22,
    "skills": {
      "s3": {
        "zh": "列出、读取、写入、复制和删除存储桶里的文件，分段上传大文件，并给出文件的公开地址，例如 listing 图片的链接。"
      }
    },
    "source": {
      "name": "s3-storage",
      "help": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/create-bucket-overview.html",
      "aspects": {},
      "fields": {
        "endpoint": {
          "label": {
            "en": "Endpoint",
            "zh": "端点"
          },
          "help": {
            "en": "For example https://s3.us-east-1.amazonaws.com.",
            "zh": "例如 https://s3.us-east-1.amazonaws.com。"
          }
        },
        "bucket": {
          "label": {
            "en": "Bucket",
            "zh": "存储桶"
          }
        },
        "region": {
          "label": {
            "en": "Region",
            "zh": "区域"
          },
          "help": {
            "en": "For example us-east-1, or auto for Cloudflare R2.",
            "zh": "例如 us-east-1，Cloudflare R2 填 auto。"
          }
        },
        "key_id": {
          "label": {
            "en": "Access key ID",
            "zh": "Access key ID"
          },
          "help": {
            "en": "cx can use only the buckets this key reaches.",
            "zh": "cx 只能使用这个密钥能访问的存储桶。"
          }
        },
        "secret_key": {
          "label": {
            "en": "Secret access key",
            "zh": "Secret access key"
          }
        },
        "public_base": {
          "label": {
            "en": "Public address",
            "zh": "公开地址"
          },
          "help": {
            "en": "Where anyone can open your bucket's files, for example https://images.example.com.",
            "zh": "存储桶文件对外公开的网址，例如 https://images.example.com。"
          }
        }
      }
    }
  },
  "dependencies": {
    "cx-sources": "^0.1.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
